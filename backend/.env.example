# Copy this file to `.env` and adjust as needed. All values shown are the defaults.

ENVIRONMENT=development

# When true (default), every AI module is allowed to fall back to a labeled
# mock result if the real model/service isn't available (no spaCy model
# downloaded, no internet for speech-to-text, transformers not installed).
USE_MOCK_AI=true

# Set to true only after `pip install -r requirements-ml-optional.txt` to
# enable the real transformer-based confidence/tone model. Leave false to
# use the fast lexical-heuristic confidence scorer instead.
ENABLE_TRANSFORMER_CONFIDENCE=false

# Demo-grade token signing secret — change this for anything beyond local use.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_MINUTES=1440

# Where the JSON "database" files are written.
DATA_DIR=data

# Language hint passed to the speech-to-text engine.
STT_LANGUAGE=en-IN
