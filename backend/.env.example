# Copy this file to `.env` and adjust as needed. All values shown are the defaults.

# Anthropic Claude API Configuration (for LLM-based grammar checking)
ANTHROPIC_API_KEY=
GRAMMAR_MODEL=claude-3-5-sonnet-20241022

ENVIRONMENT=development

# Prompt 9: Honest AI Mode.
# Defaults to false so production and development use real AI engines.
# Note: If any real engine is configured (Claude key, T5 model, Whisper, or spaCy),
# USE_MOCK_AI is automatically disabled even if set to true.
USE_MOCK_AI=false

# Multi-engine Grammar Checking Configuration (Prompt 4 & Prompt 8)
# Order of preference: claude -> t5 -> rules
GRAMMAR_ENGINE_ORDER=claude,t5,rules
# Fine-tuned T5 GEC model path (or Hugging Face Hub model ID)
GEC_MODEL_PATH=models/gec-t5

# Speech-to-Text Configuration (Prompt 5 & 6)
# Enables local faster-whisper speech recognition with int8 quantization
ENABLE_WHISPER=true
WHISPER_MODEL=base

# Set to true only after `pip install -r requirements-ml-optional.txt` to
# enable the real transformer-based confidence/tone model. Leave false to
# use the fast lexical-heuristic confidence scorer instead.
ENABLE_TRANSFORMER_CONFIDENCE=false

# Demo-grade token signing secret — change this for anything beyond local use.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_MINUTES=1440

# Where the database file (SQLite: coach.db) or data files are stored.
DATA_DIR=data

# Database connection string (optional).
# Local development: leave unset to use SQLite at {DATA_DIR}/coach.db.
# Production deployment: set DATABASE_URL (e.g. Render Postgres, Neon, Supabase)
# Example: DATABASE_URL=postgresql://user:password@ep-sample-123.region.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Language hint passed to the speech-to-text engine.
STT_LANGUAGE=en-IN

# CORS — which origins the backend allows requests from.
# On Render, set this to your Vercel URL (comma-separated or JSON array).
# Examples:
#   CORS_ORIGINS=https://ai-communication-coach.vercel.app
#   CORS_ORIGINS=https://ai-communication-coach.vercel.app,https://preview.vercel.app
#   CORS_ORIGINS=["https://ai-communication-coach.vercel.app"]
# For Vercel preview deployments you can also use:
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=
