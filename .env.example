# Copy to .env (at the project root, next to package.json) and adjust.
#
# VITE_API_BASE_URL — the full URL of the FastAPI backend including /api/v1.
#
# Local development (default):
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
#
# Vercel deployment — set this in the Vercel dashboard under Project → Settings → Environment Variables:
# VITE_API_BASE_URL=https://<your-render-backend>.onrender.com/api/v1
#
# After changing this you must rebuild the frontend (vite only embeds VITE_* vars at build time).
